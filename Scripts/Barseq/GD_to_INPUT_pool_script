#Genetic Distance (GD) defined as Cavalli-Sforza chord distance#
chord_dist = function(count1, count2){
  freq1 = count1/sum(unlist(count1))
  freq2 = count2/sum(unlist(count2))
  costheta = sum(sqrt(freq1*freq2))
  chord_dist = (2*(sqrt(2))/pi)*(sqrt(1-costheta))
  chord_dist
}






##############################################


#load dataframe#
barcode_counts5 <- read.csv("Data/2025-JCM-002-barcodes.csv")
barcode_counts5 <- subset(barcode_counts5, X != c("TGGATCTTAGGACGCAACAT"))

#GD calculation all pairs#
df <- barcode_counts5[-c(1)]
paired <- combn(colnames(df), 2)
len = length(colnames(df))
chord_df <- matrix(ncol = len, nrow = len)
chord_df[,] <- 0
colnames(chord_df) <- colnames(df)
rownames(chord_df) <- colnames(df)

for (p in seq(1, ncol(paired))) {
  colA <- paired[1,p]
  colB <- paired[2,p]
  cd <- chord_dist(df[colA], df[colB])
  chord_df[colA,colB] <- cd
  chord_df[colB,colA] <- cd
}

chord_df_data <- data.frame(chord_df)
chord_df_data <- mutate(chord_df_data, "comparison" = rownames(chord_df_data))

#long format data#
df_long <- pivot_longer(
  chord_df_data,
  cols = colnames(df),
  names_to = "Sample",
  values_to = "GD"
)



#input vector#
INPUT_VEC <- c("INPUT1A", "INPUT2A", "INPUT1B", "INPUT2B", "INPUT1C", "INPUT2C")

#sample type#
df_long$type1 <- "MOUSE"
df_long$type2 <- "MOUSE"
df_long$type1[df_long$Sample %in% INPUT_VEC] <- "INPUT"
df_long$type2[df_long$comparison %in% INPUT_VEC] <- "INPUT"

#mouse IDs#
df_long$mouse_ID1 <- parse_number(df_long$Sample)
df_long$mouse_ID1[df_long$Sample %in% INPUT_VEC] <- NA
df_long$mouse_ID2 <- parse_number(df_long$comparison)
df_long$mouse_ID2[df_long$comparison %in% INPUT_VEC] <- NA

#name tissues#

df_long$Tissue1 <- sub('^M[0-9]+', '', df_long$Sample)

df_long$Tissue2 <- sub('^M[0-9]+', '', df_long$comparison)

