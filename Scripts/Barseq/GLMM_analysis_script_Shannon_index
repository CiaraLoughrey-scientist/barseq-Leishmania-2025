#fitting of GLMM using tweedy poisson-gamma compound distribution#
#FINAL ANALYSIS VERSION#


setwd("") #add working directory details here#

#package loading#
library(tidyverse)
library(ggsci)
library(ggpubr)
library(vegan)
library(cplm)
library(tweedie)


#load SI dataset#
SI_data <-  read.csv("Results/Diversity_analysis/SHANNON_DATA_reinf3.csv")

#change mouse ID to factor#
SI_data$mouse_ID <- as.factor(SI_data$mouse_ID)


  

#add animal groups#
#add groups#
SI_data$group <- NULL
SI_data$group[SI_data$mouse_ID %in% c("1", "2", "3", "4", "5")] <- "1single_04wk"
SI_data$group[SI_data$mouse_ID %in% c("12", "13", "14")] <- "1single_10wk"
SI_data$group[SI_data$mouse_ID %in% c("21", "22", "23", "24", "25")] <- "1single_12wk"
SI_data$group[SI_data$mouse_ID %in% c("15", "16", "17", "18", "19", "20")] <- "2reinf_2wk"
SI_data$group[SI_data$mouse_ID %in% c( "6", "7", "8", "9", "10", "11")] <- "2reinf_2d"

#add groups#
SI_data$group2 <- NULL
SI_data$group2[SI_data$mouse_ID %in% c("1", "2", "3", "4", "5")] <- "1single_early"
SI_data$group2[SI_data$mouse_ID %in% c("12", "13", "14")] <- "1single_late"
SI_data$group2[SI_data$mouse_ID %in% c("21", "22", "23", "24", "25")] <- "1single_late"
SI_data$group2[SI_data$mouse_ID %in% c("15", "16", "17", "18", "19", "20")] <- "2reinf_2wk"
SI_data$group2[SI_data$mouse_ID %in% c( "6", "7", "8", "9", "10", "11")] <- "2reinf_2d"

#add tissue type#
SI_data$tissue_type1 <- "VIS"
SI_data$tissue_type1[SI_data$tissue == "SKIN"] <- "SKIN"



#subset for early vs late only#
SI_data_sub <- subset(SI_data, group2 %in% c("1single_early", "1single_late") & tissue_type1 == "SKIN")

#subset for reinfection comparison only#
SI_data_sub2 <- subset(SI_data, group %in% c("1single_12wk", "2reinf_2wk") & tissue_type1 == "SKIN")



#test model with random effects as mouse ID#
#test model with fixed effects of early vs late groups and single vs reinfection groups#

#model for early vs late skin biopsies#

#full model#
skin_m1 <- cpglmm(formula = Shannon_index ~ group2 + (1|mouse_ID), data = SI_data_sub)
skin_m1
#AIC  BIC logLik deviance
#164.8 176.7 -78.39    156.8

#remove group fixed effect so only random effects included#
skin_m1a <- cpglmm(formula = Shannon_index ~ (1|mouse_ID), data = SI_data_sub)
skin_m1a
#AIC  BIC logLik deviance #best model by AIC#
#162.8 171.7 -78.42    156.8

#remove group random effect so only fixed effects included#
skin_m1b <- cpglm(formula = Shannon_index ~ group2, data = SI_data_sub)
skin_m1b
#AIC  161.73 

#gini comparison#
SI_data_sub_gini <- SI_data_sub
da <- transform(SI_data_sub_gini, P1 = fitted(skin_m1), P2 = fitted(skin_m1a), 
                P3 = fitted(skin_m1b))
gg <- gini(loss = "Shannon_index", score = paste("P", 1:3, sep = ""), 
           data = da)
gg
#selects P2 as best model#
#so early vs late doesn't matter, mouse ID explains variation#

#plot Lorenz curves#
theme_set(theme_bw())
plot(gg)
plot(gg, overlay = FALSE)


