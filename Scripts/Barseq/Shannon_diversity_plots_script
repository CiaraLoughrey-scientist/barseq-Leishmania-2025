#shannon index plots and stats#

#set working directory#
setwd("") #add working directory details here#

#package loading#
library(tidyverse)
library(ggsci)
library(ggpubr)
library(vegan)


#load data#
#data load#
reinf3_df <- read.csv("Results/Diversity_analysis/SHANNON_DATA_reinf3.csv")


#add animal groups#
#add groups#
reinf3_df$group <- NULL
reinf3_df$group[reinf3_df$mouse_ID %in% c("1", "2", "3", "4", "5")] <- "1single_04wk"
reinf3_df$group[reinf3_df$mouse_ID %in% c("12", "13", "14")] <- "1single_10wk"
reinf3_df$group[reinf3_df$mouse_ID %in% c("21", "22", "23", "24", "25")] <- "1single_12wk"
reinf3_df$group[reinf3_df$mouse_ID %in% c("15", "16", "17", "18", "19", "20")] <- "2reinf_2wk"
reinf3_df$group[reinf3_df$mouse_ID %in% c( "6", "7", "8", "9", "10", "11")] <- "2reinf_2d"

reinf3_df$group2 <- NULL
reinf3_df$group2[reinf3_df$mouse_ID %in% c("1", "2", "3", "4", "5")] <- "1single_early"
reinf3_df$group2[reinf3_df$mouse_ID %in% c("12", "13", "14")] <- "1single_late"
reinf3_df$group2[reinf3_df$mouse_ID %in% c("21", "22", "23", "24", "25")] <- "1single_late"
reinf3_df$group2[reinf3_df$mouse_ID %in% c("15", "16", "17", "18", "19", "20")] <- "2reinf_2wk"
reinf3_df$group2[reinf3_df$mouse_ID %in% c( "6", "7", "8", "9", "10", "11")] <- "2reinf_2d"


#plot data#


#all visceral tissues#
ggplot(subset(reinf3_df, group %in% c("1single_04wk", "1single_10wk", "1single_12wk") & tissue != "SKIN"), 
       aes(y= Shannon_index, x = group2)) + 
  geom_jitter(aes(colour = group2),
              size = 2.5, stroke = 2,
              position = position_jitterdodge(dodge.width = .75, jitter.width = 0.3)) + 
  geom_boxplot(aes(fill = group2), alpha = 0.3,
               outlier.shape = NA, 
               width = 0.75, lwd = 0.8, fatten = 2, show.legend = FALSE) +
  labs(title = "Systemic parasite diversity\n", colour = "Infection phase:", x= "\nInfection phase", y = "Shannon Index\n") +
  scale_y_continuous(expand = expansion(mult = c(0, .1)), limits = c(0, 4)) +
  #scale_x_discrete(expand = expansion(mult = c(0.15, 0))) +
  scale_x_discrete(labels = c("Early",  "Chronic")) +
  theme_bw() + theme(legend.title = element_text(size = 18, hjust = 0.5),
                     plot.title = element_text(hjust = 0.5, size = 30),
                     legend.title.position = "top",
                     legend.position = "bottom",
                     panel.border = element_blank(), 
                     panel.grid.major = element_blank(),
                     panel.grid.minor = element_blank(),
                     axis.title = element_text(size=28), 
                     axis.line = 
                       element_line(colour = "black"), 
                     axis.text.x = element_text(size = 20, colour = "black"),
                     axis.text.y = element_text(size = 20, colour = "black"),
                     legend.text = element_text(size = 16, colour = "black"),
                     strip.text.x = element_text(size = 20)) +
  scale_fill_manual(values = c("#21918c", "#440154"), labels = c("Early",  "Chronic")) +
  scale_colour_manual(values = c("#21918c", "#440154"), labels = c("Early", "Chronic"))+
  guides(fill="none") +
  stat_pwc(aes(y=Shannon_index, x=group2, group = group2),
           hide.ns = "p", vjust = -0.25, step.increase = 0.15,
           bracket.nudge.y = 0.1, tip.length = 0, size = 0.5, label.size = 5, label = "p", 
           method = "wilcox_test") +
  facet_wrap(~tissue, nrow = 1, scale = "free_x", labeller = as_labeller(
    c(BM = "Bone Marrow", GUT = "Gut", L = "Liver", LN =  "Lymph Node", LUNG = "Lung", S = "Spleen", SKIN = "Skin")))
ggsave(paste0(file = "Results/Figures_for_paper/reinf3_shannon_plot2.png"), height = 6, width=16)
ggsave(paste0(file = "Results/Figures_for_paper/reinf3_shannon_plot2.pdf"), height = 6, width=16)

