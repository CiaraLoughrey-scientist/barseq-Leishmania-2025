df_p_val <- subset(reinf3_df4_skin_in2, tissue_output == "VIS" & tissue_type == "SKIN") %>%
  group_by(tissue_output) %>%
  rstatix::wilcox_test(FP~ group2, detailed = T, paired = F) 
write.csv(df_p_val, file = "Results/Stats/mann_whitney_SKIN_INPUT_single_VS_reinfection_all_skin_to_vis.csv")


