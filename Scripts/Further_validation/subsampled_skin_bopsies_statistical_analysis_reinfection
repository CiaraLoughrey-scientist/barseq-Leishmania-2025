#time point comparison for total TSFP from skin to visceral tissues#
df_p_val <- subset(reinf3_df4_skin_in_sub, tissue_output != "SKIN" ) %>%
  group_by(OUTPUT3) %>%
  rstatix::wilcox_test(GROUPED_FP2~ group2, detailed = T, paired = F) 
write.csv(df_p_val, file = "Stats/mann_whitney_SKIN_INPUT_EARLY_VS_LATE_31032026.csv")


