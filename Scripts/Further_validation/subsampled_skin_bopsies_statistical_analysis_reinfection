#find total FP seeded to visceral, skin and all tissues for each sample for each mouse at 4, 10 and 12 weeks#
#group by input, output and mouse ID#
#remove all samples with negative FP (sample FP to same tissue is negative value)#
reinf3_df2 <- reinf3_df2 %>%
  #subset(FP > 0) %>%
  group_by(INPUT_POOL, mouse_ID) %>%
  mutate(TOTAL_FP = sum(FP))

#sum FPs for each individual tissue input to grouped by tissue outputs (vis or skin)#
reinf3_df3 <- reinf3_df2 %>%
  group_by(INPUT_POOL, mouse_ID, tissue_output) %>%
  mutate(GROUPED_FP = sum(FP))

#sum FPs for each tissue type input to grouped by tissue outputs (vis or skin)#
reinf3_df4 <- reinf3_df3 %>%
  group_by(mouse_ID, tissue_output, tissue_type) %>%
  mutate(TISSUE_TYPE_TOTAL_FP = sum(FP))

#sum FPs for each tissue output with input grouped by tissue type (skin or vis)#
reinf3_df5 <- reinf3_df4 %>%
  group_by(OUTPUT3, mouse_ID, tissue_type) %>%
  mutate(GROUPED_FP2 = sum(FP))


#subset for skin in#
