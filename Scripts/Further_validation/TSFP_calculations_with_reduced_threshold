  #we could apply a scale here based on FP from input?#
  #but for now, just set as a shape#
  V(g)$shape <- "sphere"
  #weights for mst are 1/FP between vertices#
  edgeweights <- (1/E(g)$weight)
  #Convert the graph adjacency object into a minimum spanning tree based on Prim's algorithm#
  mst <- mst(g, algorithm="prim", weights = edgeweights)
  edgeweights2 <- (1/E(mst)$weight)
  
  ggraph(g, layout = "circle") +
    geom_edge_fan( aes(edge_colour = weight, width  = weight, alpha = weight), 
