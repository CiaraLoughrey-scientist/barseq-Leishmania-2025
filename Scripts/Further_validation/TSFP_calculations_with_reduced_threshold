  FP_df_resid <- data.frame(FP_residual)
  #gives a signed value for FP for each tissue combo#
  
  #remove values below 1 to enable building network of only positive seeding#
  FP_df_final <- FP_df_resid %>% replace_with_na_all(condition = ~.x < 1)
  #change column and row names to just the tissue ID#
