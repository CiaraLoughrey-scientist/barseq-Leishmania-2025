    geom_edge_link( aes(edge_colour = weight, width  = weight, alpha = weight), 
                    arrow = arrow(length = unit(7, 'mm'), type = "closed"),
                    show.legend = TRUE) +
    geom_node_point(colour = "grey", size = 3) +
    geom_node_text(aes(label = name),  colour = 'black', size=8,
                   show.legend = FALSE) +
    scale_edge_color_continuous(
      high = "#0d0887",
      low = "#f0f921",
      space = "Lab",
      guide = "edge_colourbar",
      aesthetics = "edge_colour",
      limits = c(0, NA)
    ) +
    theme_bw() +
    labs(title = "MST network\n", edge_colour = "Fractional FP seeding:") +
    theme(legend.title = element_text(size = 16),
          legend.position = "bottom",
          plot.title = element_text(hjust = 0.5, size = 24),
          panel.border = element_blank(),
          plot.caption = element_text(size = 14),
          panel.grid.major = element_blank(),
          panel.grid.minor = element_blank(),
          legend.text = element_text(size = 12, hjust = 1, angle = 45),
          axis.text.x=element_blank(), 
          axis.ticks.x=element_blank(), 
          axis.text.y=element_blank(),  
          axis.ticks.y=element_blank(),
          axis.title = element_blank()) +
    guides (edge_width = "none", edge_alpha = "none")
  ggsave(paste0("FP_by_tissue_reduced_threshold/FP_networks/MST_network",paste0("mouse",mouse),".png"), width = 12, height = 10)
  ggsave(paste0("FP_by_tissue_reduced_threshold/FP_networks/MST_network",paste0("mouse",mouse),".pdf"), width = 12, height = 10)
  
  #save metrics data#
  bet <- betweenness(mst, directed = FALSE, weights = edgeweights2) #find key connector tissues so don't use direction#
  harm <- harmonic_centrality(mst, weights = edgeweights2) #1/average path length to each tissue#
  bet <- bet[order(names(bet))]
  harm <- harm[order(names(harm))]
  bet2 <- betweenness(g, directed = FALSE, weights = edgeweights) #use the inverted values to find the shortest paths here#
  harm2 <- harmonic_centrality(g, weights = edgeweights) #use the inverted values as weights to find the shortest paths#
  bet2 <- bet[order(names(bet2))]
  harm2 <- harm[order(names(harm2))]
  eigen <- eigen_centrality(mst, directed  = TRUE, weights = NULL) #weight is connection strength so keep as weight NULL to use weights values#
  eigen2 <- eigen_centrality(g, directed  = TRUE, weights = NULL) #weight is connection strength so keep as weight NULL to use weights values#
  eigen3 <- eigen_centrality(g, directed  = FALSE, weights = NULL)
  Indegree <- degree(mst, mode="in")
  Outdegree <- degree(mst, mode="out")
  Indegree2 <- degree(g, mode="in")
  Outdegree2 <- degree(g, mode="out")
  
  #save betweenness and harmonic and eigen centrality scores#
  bet_data <- bind_rows(bet_data, bet)
  harm_data <- bind_rows(harm_data, harm)
  bet_data2 <- bind_rows(bet_data2, bet2)
  harm_data2 <- bind_rows(harm_data2, harm2)
  eigen_data <- bind_rows(eigen_data, eigen$vector)
  eigen_data2 <- bind_rows(eigen_data2, eigen2$vector)
  eigen_data3 <- bind_rows(eigen_data3, eigen3$vector)
  in_degree <- bind_rows(in_degree, Indegree)
  out_degree <- bind_rows(out_degree, Outdegree)
  in_degree2 <- bind_rows(in_degree2, Indegree2)
  out_degree2 <- bind_rows(out_degree2, Outdegree2)
}


