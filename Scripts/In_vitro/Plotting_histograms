setwd("R:/rsrch/pmk2/lab/Ciara/Papers/Skin paper/Data/In_vitro_infection_analysis")

#load data#
Infection_burden_b1_to_5 <- read.csv("Infection_burden_b1_to_5.csv")


#load packages#

library(tidyverse)


#figures for paper#
#plots#
ggplot(subset(Infection_burden_b1_to_5, Timepoint_hr %in% 3), aes(x = Parasite_burden)) +
  geom_histogram(fill = "white", colour = "black", binwidth = 1) +
  labs(title = "3hr post-infection", x = "\nParasite burden", y = "% of counted host cells\n") +
  scale_y_continuous(expand = c(0,0)) +
  scale_x_continuous(expand = c(0,0))+
  theme_bw() +
  theme(plot.title = element_text(hjust = 0.5, size = 32),
        panel.border = element_blank(),
        panel.grid.minor = element_blank(),
        axis.title = element_text(size=28), 
        axis.line = 
          element_line(colour = "black"), 
        axis.text.x = element_text(size = 20, colour = "black"),
        axis.text.y = element_text(size = 20, colour = "black"),
        strip.text = element_text(size = 20),
        panel.spacing.y = unit(2, "lines")) +
  facet_grid(Barcode_ID~.)

#save#
ggsave("3hr_plot.png", width = 8, height = 10)
ggsave("3hr_plot.pdf", width = 8, height = 10)

